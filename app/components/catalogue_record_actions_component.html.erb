<div id="catalogue-record-actions" class="col-12 sticky-md-top py-2 mb-4 d-print-none">
  <div class="justify-content-start">
    <% if render_online? %>
      <a href="<%= online_url %>" class="btn btn-primary mb-2 me-2 me-lg-4 px-4"><%= online_label %></a>
      <% else %>
      <span class="btn disabled mb-2 me-2 me-lg-4 px-4">Not online</span>
    <% end %>
    <% if render_request? %>
      <%= link_to raw(request_button_label), request_button_href, id: "request-btn", class: "btn btn-primary mb-2 me-2 me-lg-4 px-4", target: request_button_is_dfl ? "_top" : nil %>
    <% end %>
    <%= copies_direct_button(@document.id) %>
  </div>
</div>
